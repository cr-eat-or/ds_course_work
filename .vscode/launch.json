{
    "version": "0.2.0",
    "configurations": [
        {
            "name": "ds_course_work (main)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/main",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "make (debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "windows": {
                "program": "${workspaceFolder}/build/main.exe"
            },
            "setupCommands": [
                {
                    "description": "Красивый вывод для gdb",
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        },
        {
            "name": "test.exe (unit tests)",
            "type": "cppdbg",
            "request": "launch",
            "program": "${workspaceFolder}/build/test.exe",
            "args": [],
            "cwd": "${workspaceFolder}",
            "preLaunchTask": "make (debug)",
            "MIMode": "gdb",
            "miDebuggerPath": "gdb",
            "windows": {
                "program": "${workspaceFolder}/build/test.exe"
            },
            "setupCommands": [
                {
                    "text": "-enable-pretty-printing",
                    "ignoreFailures": true
                }
            ]
        }
    ]
}