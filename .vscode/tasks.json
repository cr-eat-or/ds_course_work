{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "make (debug)",
            "type": "shell",
            "command": "make",
            "args": ["DEBUG=1", "all"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": ["$gcc"],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "detail": "Сборка main.exe и test.exe с -g -O0 (DEBUG=1)."
        },
        {
            "label": "make (clean)",
            "type": "shell",
            "command": "make",
            "args": ["clean"],
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "problemMatcher": []
        }
    ]
}
